# Backend Development Environment
# RENAME THIS FILE TO .env for development

# Django Core Settings
SECRET_KEY=dev-secret-key-not-for-production-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///./db.sqlite3
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Email Configuration (Console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Dr. Ajay Practice <dev@localhost>

# Security Settings (Development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT/Authentication
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx

# SSL/HTTPS Configuration (Development)
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=None

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_SECONDS=3600

# Logging Configuration
LOG_LEVEL=DEBUG

# Time Zone
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Internationalization
LANGUAGE_CODE=en-us 