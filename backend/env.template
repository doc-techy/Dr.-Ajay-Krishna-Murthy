# Backend Environment Configuration Template
# Copy this file to .env for your environment

# Django/Application Settings
SECRET_KEY=your-super-secret-django-key-here-generate-a-strong-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/dr_ajay_db
DB_NAME=dr_ajay_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Dr. Ajay Practice <noreply@drajay.com>

# Security Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.com

# JWT/Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MEDIA_ROOT=/var/www/dr_ajay/media
STATIC_ROOT=/var/www/dr_ajay/static
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx

# API Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/dr_ajay/app.log

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=UTC

# SMS Configuration (Optional - for appointment reminders)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway (Optional)
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Google Calendar Integration (Optional)
# GOOGLE_CALENDAR_CREDENTIALS_FILE=/path/to/credentials.json
# GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_STORAGE_PATH=/var/backups/dr_ajay
BACKUP_RETENTION_DAYS=30

# Monitoring and Health Checks
HEALTH_CHECK_ENABLED=True
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# SSL/HTTPS Configuration (Production)
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_SECONDS=3600

# Time Zone
TIME_ZONE=UTC
USE_TZ=True

# Internationalization
LANGUAGE_CODE=en-us
LANGUAGES=en,es,fr

# Third-party Integrations
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
# RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key

# Development/Testing
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/test_dr_ajay_db
FIXTURE_DIRS=/path/to/fixtures 