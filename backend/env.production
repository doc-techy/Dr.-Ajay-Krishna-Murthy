# Backend Production Environment
# RENAME THIS FILE TO .env for production deployment
# CRITICAL: Replace ALL placeholder values with actual production values

# Django Core Settings
SECRET_KEY=REPLACE_WITH_50_CHAR_RANDOM_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=65.0.97.115,localhost,127.0.0.1

# Database Configuration (SQLite for production - simpler deployment)
DATABASE_URL=sqlite:///./production_db.sqlite3
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=production_db.sqlite3

# Email Configuration - UPDATE WITH PRODUCTION EMAIL SERVICE
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=YOUR_EMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=Dr. Ajay Practice <noreply@your-domain.com>

# Security Settings - UPDATE WITH YOUR SERVER IP
CORS_ALLOWED_ORIGINS=http://65.0.97.115:3000,http://65.0.97.115
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://65.0.97.115:3000,http://65.0.97.115

# JWT/Authentication
JWT_SECRET_KEY=REPLACE_WITH_STRONG_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MEDIA_ROOT=/var/www/dr_ajay/media
STATIC_ROOT=/var/www/dr_ajay/static
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx

# SSL/HTTPS Configuration (Production) - Set to False for HTTP
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=None

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_SECONDS=3600

# Logging Configuration
LOG_LEVEL=WARNING
LOG_FILE=/var/log/dr_ajay/app.log

# Time Zone
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Internationalization
LANGUAGE_CODE=en-us 