# Backend Production Environment
# RENAME THIS FILE TO .env for production deployment
# CRITICAL: Replace ALL placeholder values with actual production values

# Django Core Settings
SECRET_KEY=REPLACE_WITH_50_CHAR_RANDOM_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-backend-domain.com

# Database Configuration - UPDATE WITH PRODUCTION DATABASE
DATABASE_URL=postgresql://username:password@your-db-host:5432/dr_ajay_production
DB_NAME=dr_ajay_production
DB_USER=production_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_HOST=your-database-host.com
DB_PORT=5432

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://your-redis-host:6379/0
CACHE_TTL=1800

# Email Configuration - UPDATE WITH PRODUCTION EMAIL SERVICE
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=YOUR_EMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=Dr. Ajay Practice <noreply@your-domain.com>

# Security Settings - UPDATE WITH YOUR FRONTEND DOMAIN
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# JWT/Authentication
JWT_SECRET_KEY=REPLACE_WITH_STRONG_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MEDIA_ROOT=/var/www/dr_ajay/media
STATIC_ROOT=/var/www/dr_ajay/static
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx

# SSL/HTTPS Configuration (Production)
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
SESSION_EXPIRE_SECONDS=3600

# Logging Configuration
LOG_LEVEL=WARNING
LOG_FILE=/var/log/dr_ajay/app.log

# Performance & Monitoring
SENTRY_DSN=YOUR_SENTRY_DSN_FOR_ERROR_TRACKING

# Time Zone
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Internationalization
LANGUAGE_CODE=en-us 