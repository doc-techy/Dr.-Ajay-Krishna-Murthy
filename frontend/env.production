# Frontend Production Environment
# RENAME THIS FILE TO .env.production
# CRITICAL: Replace all placeholder values with actual production values

# Environment
NODE_ENV=production

# API Configuration - Using your server IP
NEXT_PUBLIC_BACKEND_URL=http://65.0.97.115
NEXT_PUBLIC_API_VERSION=v1

# Application Configuration
NEXT_PUBLIC_APP_NAME="Dr. Ajay Krishna Murthy - Medical Practice"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION="Professional Medical Practice Management System"

# Security - Generate strong random strings
NEXTAUTH_URL=http://65.0.97.115:3000
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_32_CHAR_SECRET

# Contact Information - UPDATE WITH REAL DETAILS
NEXT_PUBLIC_CONTACT_EMAIL=info@drajay.com
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX
NEXT_PUBLIC_CONTACT_ADDRESS="Your Clinic Address, City, State, PIN"

# Business Hours
NEXT_PUBLIC_BUSINESS_HOURS="Mon-Fri: 9:00 AM - 6:00 PM, Sat: 9:00 AM - 2:00 PM"

# Emergency Contact
NEXT_PUBLIC_EMERGENCY_PHONE=+91-XXXXXXXXXX

# Production Settings (HTTP for now)
FORCE_HTTPS=false

# Domain Configuration
NEXT_PUBLIC_DOMAIN=65.0.97.115
NEXT_PUBLIC_FRONTEND_PORT=3000

# Performance & Monitoring
NEXT_PUBLIC_LOG_LEVEL=error 