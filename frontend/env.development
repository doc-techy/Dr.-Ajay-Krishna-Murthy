# Frontend Development Environment
# RENAME THIS FILE TO .env.local for development

# Environment
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Application Configuration
NEXT_PUBLIC_APP_NAME="Dr. Ajay Krishna Murthy - Medical Practice (Dev)"
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_APP_DESCRIPTION="Professional Medical Practice Management System - Development"

# Security (Development)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-key-not-for-production

# Contact Information (Development)
NEXT_PUBLIC_CONTACT_EMAIL=dev@drajay.com
NEXT_PUBLIC_CONTACT_PHONE=+91-1234567890
NEXT_PUBLIC_CONTACT_ADDRESS="Development Address, City, State, PIN"

# Business Hours
NEXT_PUBLIC_BUSINESS_HOURS="Mon-Fri: 9:00 AM - 6:00 PM, Sat: 9:00 AM - 2:00 PM"

# Emergency Contact
NEXT_PUBLIC_EMERGENCY_PHONE=+91-0987654321

# Development Settings
FORCE_HTTPS=false
NEXT_PUBLIC_LOG_LEVEL=debug 