# Frontend Environment Configuration Template
# Copy this file to .env.local for development or .env.production for production

# API Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Application Configuration
NEXT_PUBLIC_APP_NAME="Dr. Ajay Medical Practice"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION="Professional Medical Practice Management System"

# Environment
NODE_ENV=development

# Security
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here-generate-a-strong-random-string

# Database URL (if using client-side connections)
# DATABASE_URL=postgresql://username:password@localhost:5432/dr_ajay_db

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# Social Media Links (Optional)
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-handle
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@drajay.com
NEXT_PUBLIC_CONTACT_PHONE=+1-234-567-8900
NEXT_PUBLIC_CONTACT_ADDRESS="123 Medical Center Drive, City, State 12345"

# Business Hours
NEXT_PUBLIC_BUSINESS_HOURS="Mon-Fri: 9:00 AM - 6:00 PM, Sat: 9:00 AM - 2:00 PM"

# Emergency Contact
NEXT_PUBLIC_EMERGENCY_PHONE=+1-234-567-8911

# SSL/TLS Configuration (Production)
# FORCE_HTTPS=true

# Domain Configuration (Production)
# NEXT_PUBLIC_DOMAIN=drajay.com
# NEXT_PUBLIC_SUBDOMAIN=www

# Email Configuration (if using client-side email)
# NEXT_PUBLIC_EMAIL_SERVICE_ID=your-emailjs-service-id
# NEXT_PUBLIC_EMAIL_TEMPLATE_ID=your-emailjs-template-id
# NEXT_PUBLIC_EMAIL_PUBLIC_KEY=your-emailjs-public-key

# File Upload Configuration
# NEXT_PUBLIC_MAX_FILE_SIZE=5242880
# NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.jpg,.jpeg,.png,.doc,.docx

# Rate Limiting
# NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
# NEXT_PUBLIC_RATE_LIMIT_WINDOW=15

# Monitoring and Logging
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_LOG_LEVEL=error

# CDN Configuration (Production)
# NEXT_PUBLIC_CDN_URL=https://cdn.drajay.com
# NEXT_PUBLIC_ASSETS_URL=https://assets.drajay.com 